# PostgreSQL Database Connection
# You can provide a single connection string (e.g. Neon, Supabase, Vercel Postgres, Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fake_store

# Or discrete connection parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=fake_store
# PGSSL=false
